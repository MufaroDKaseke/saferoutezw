# Non-secret settings for the Next.js app. One source of truth for three consumers:
#   - the CI build (.github/workflows/deploy.yml loads it into the build environment),
#   - the server-side fallback build in deploy.sh,
#   - the pm2 runtime environment (ecosystem.config.cjs).
# NEXT_PUBLIC_* values are baked into the build, so changing them needs a new build (a deploy).
# Never put a secret in this file.

# Run the dashboard and public site against the real API instead of the demo data.
NEXT_PUBLIC_DATA_MODE=api

# The API listens on loopback only. The browser never calls it directly: Next proxies /backend/* to it.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_INTERNAL_URL=http://127.0.0.1:8000
