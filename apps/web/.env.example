# Data mode for the whole frontend.
#   mock : every page runs on the clearly-labelled synthetic dataset in src/lib/mock.
#   api  : pages call the FastAPI backend. Only endpoints that actually exist are
#          called (today that is GET /health); the other pages show a
#          "not available yet" state instead of inventing data.
NEXT_PUBLIC_DATA_MODE=mock

# FastAPI origin. The browser never calls this directly (the backend has no CORS);
# Next proxies /backend/* to it. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Simulated latency in mock mode, in milliseconds. Makes loading states visible.
NEXT_PUBLIC_MOCK_LATENCY_MS=250

# Map tiles. Defaults to OpenStreetMap standard tiles, which are fine for
# development and light internal use. Check the tile usage policy of whichever
# provider you choose before production use.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
