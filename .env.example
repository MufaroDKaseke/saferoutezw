# Copy to .env (git-ignored) and fill in your local PostgreSQL credentials.
# The database URL is built in code with SQLAlchemy URL.create(), so the
# password may contain special characters and must NOT be URL-encoded here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=<your_postgres_username>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=saferoutezw
# Optional: seconds to wait when connecting before giving up (default 5).
# POSTGRES_CONNECT_TIMEOUT=5
# Separate database used by destructive integration tests. Never point this at
# a database that holds real data.
POSTGRES_TEST_DB=saferoutezw_test

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
API_HOST=127.0.0.1
API_PORT=8000

# Local RSS scheduler: `cd apps/api && python -m app.jobs.scheduler`
# Seconds between polling cycles (minimum 30).
RSS_POLL_INTERVAL_SECONDS=180
# Run one polling cycle immediately when the scheduler starts.
RSS_POLL_ON_STARTUP=true
# Set to false to make the scheduler command exit without polling.
RSS_SCHEDULER_ENABLED=true
# Optional: feeds fetched in parallel within one cycle (1-8, default 4).
# RSS_POLL_MAX_WORKERS=4

# Article pipeline (screen -> fetch full article -> redact -> OpenAI -> candidate incidents).
# Without OPENAI_API_KEY articles are still screened and fetched, but nothing is extracted.
# Never commit a real key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# PIPELINE_ENABLED=true
# PIPELINE_INTERVAL_SECONDS=180
# PIPELINE_BATCH_SIZE=25
# PIPELINE_MAX_ATTEMPTS=3
# ARTICLE_FETCH_TIMEOUT_SECONDS=20
# ARTICLE_FETCH_DELAY_SECONDS=1.0
# ARTICLE_MIN_WORDS=60
# EXTRACTION_MIN_CONFIDENCE=0.6

# --- Authentication (see README: "REST API, sign-in and the editorial workflow") ---
# SESSION_TTL_MINUTES=480
# COOKIE_SECURE=false          # true when served over HTTPS
# TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Geolocation ---
# GEOCODER=google              # or "none"
# GOOGLE_MAPS_API_KEY=
# BLACKSPOT_MATCH_RADIUS_M=500

# --- Public site: routing, subscriptions, notifications ---
# Geoapify powers place search and route planning (required for /public/routes).
GEOAPIFY_API_KEY=
ROUTING_PROVIDER=geoapify
ROUTING_TIMEOUT_SECONDS=10
ROUTE_HAZARD_BUFFER_M=2000
PUBLIC_CORS_ORIGINS=
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_WRITE_RATE_LIMIT_PER_MINUTE=10
TRUST_FORWARDED_FOR=false
# Subscriber data protection. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUBSCRIBER_ENCRYPTION_KEY=
SUBSCRIBER_DIGEST_KEY=
# Only "mock" exists: nothing is sent to real phones.
NOTIFICATION_PROVIDER=mock
# Local demo only: return the one-time code in the API response (mock provider).
MOCK_EXPOSE_CODES=false
SUBSCRIPTION_CORRIDORS=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Social media ingestion (Apify). OFF by default: every poll is a paid Actor run. ---
# Only accounts in config/social_sources.yaml (synced with scripts/seed_social_sources.py) are read.
APIFY_API_TOKEN=
SOCIAL_INGESTION_ENABLED=false
# SOCIAL_POLL_CHECK_SECONDS=300          # how often the scheduler looks for due accounts
# SOCIAL_RUN_TIMEOUT_SECONDS=600         # hard stop for one Actor run
# SOCIAL_MAX_CHARGE_USD_PER_RUN=0.25     # Apify aborts the run at this spend
# SOCIAL_MAX_RUNS_PER_DAY=24             # Actor runs per rolling 24 h, all accounts
# SOCIAL_FIRST_RUN_LOOKBACK_HOURS=48
# SOCIAL_RETRY_AFTER_ERROR_MINUTES=30

# Incident geolocation: geoapify (default) | google | none. Kilometre pegs become editor-confirmed ESTIMATES only.
GEOCODER=geoapify
