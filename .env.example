# Copy to .env (git-ignored) and fill in your local PostgreSQL credentials.
# The database URL is built in code with SQLAlchemy URL.create(), so the
# password may contain special characters and must NOT be URL-encoded here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=<your_postgres_username>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=saferoutezw
# Optional: seconds to wait when connecting before giving up (default 5).
# POSTGRES_CONNECT_TIMEOUT=5
# Separate database used by destructive integration tests. Never point this at
# a database that holds real data.
POSTGRES_TEST_DB=saferoutezw_test

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
API_HOST=127.0.0.1
API_PORT=8000

# Local RSS scheduler: `cd apps/api && python -m app.jobs.scheduler`
# Seconds between polling cycles (minimum 30).
RSS_POLL_INTERVAL_SECONDS=180
# Run one polling cycle immediately when the scheduler starts.
RSS_POLL_ON_STARTUP=true
# Set to false to make the scheduler command exit without polling.
RSS_SCHEDULER_ENABLED=true
# Optional: feeds fetched in parallel within one cycle (1-8, default 4).
# RSS_POLL_MAX_WORKERS=4

# Article pipeline (screen -> fetch full article -> redact -> OpenAI -> candidate incidents).
# Without OPENAI_API_KEY articles are still screened and fetched, but nothing is extracted.
# Never commit a real key.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# PIPELINE_ENABLED=true
# PIPELINE_INTERVAL_SECONDS=180
# PIPELINE_BATCH_SIZE=25
# PIPELINE_MAX_ATTEMPTS=3
# ARTICLE_FETCH_TIMEOUT_SECONDS=20
# ARTICLE_FETCH_DELAY_SECONDS=1.0
# ARTICLE_MIN_WORDS=60
# EXTRACTION_MIN_CONFIDENCE=0.6
